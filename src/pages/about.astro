---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/ui';

const locale: Locale = 'de';
---

<BaseLayout title="Über mich · Roomie" description="Über mich und die Entstehung von roomie." locale={locale}>
	<h1>Über mich</h1>
	<p class="placeholder">
		Kommt bald! Diese Seite ist noch in Arbeit. Hier gibt es demnächst mehr über meine Person.
	</p>
</BaseLayout>

<style>
	h1 {
		margin: 0 0 28px;
		font-size: 2.6rem;
	}
	.placeholder {
		border: 2px dashed var(--ink-soft);
		border-radius: var(--radius-md);
		padding: 24px;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	@media (max-width: 700px) {
		h1 {
			font-size: 2rem;
		}
	}
</style>
