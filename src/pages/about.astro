---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/ui';
import '../styles/about.css';

const locale: Locale = 'de';
const introPostHref = getRelativeLocaleUrl(locale, '/blog/roomie-intro');
---

<BaseLayout title="Über mich · Roomie" description="Über mich und die Entstehung von roomie." locale={locale}>
	<header class="page-head">
		<h1>Über mich</h1>
		<p class="page-sub">Die Person hinter roomie</p>
	</header>

	<section class="profile-hero tape">
		<img
			class="portrait"
			src="/images/authors/dominik-weber-large.png"
			width="240"
			height="240"
			alt="Dominik Weber"
			loading="eager"
			decoding="async"
		/>
		<div>
			<h2>Dominik Weber</h2>
			<p class="tagline">Master of Engineering | Lehrkraft | Embedded-Systems-Ingenieur</p>
			<p>Servus! Mein Name ist Dominik! Als Lehrkraft an einer Technikerschule für KI und als Ingenieur mit mehrjähriger Berufserfahrung im Bereich Firmware- und Embedded-Systems-Entwicklung verbinde ich leidenschaftlich Wissensvermittlung mit Engineering.</p>
			<p>Ich bin der Meinung, dass viele Dinge im Leben so viel einfacher sein können, wenn man Sachverhalte verständlich aufbereitet und sich als Vermittler von Informationen in seine Mitmenschen hineinversetzen kann.</p>
		</div>
	</section>

	<section aria-labelledby="hobbies-heading">
		<h2 id="hobbies-heading" class="section-title">Hobbys</h2>
		<ul class="hobby-grid">
			<li class="hobby-card" style={{ background: 'var(--mint)' }}>Schlagzeuger in einer Metalband</li>
			<li class="hobby-card" style={{ background: 'var(--lavender)' }}>Embedded- und Coding-Projekte</li>
			<li class="hobby-card" style={{ background: 'var(--cream)' }}>KI-bezogene Literatur und Projekte</li>
		</ul>
	</section>

	<section aria-labelledby="work-heading">
		<h2 id="work-heading" class="section-title">Arbeitserfahrung</h2>
		<div class="timeline-card" style={{ background: 'var(--pink-soft)' }}>
			<ol class="timeline">
				<li>
					<span class="when">seit 05/2026</span>
					<strong>Embedded Systems Engineer</strong>
					<span class="meta">PCB Arts GmbH · Fürth, Bayern</span>
					<ul>
						<li>BSP-Entwicklung für Linux4Tegra auf NVIDIA-Jetson-Plattformen</li>
					</ul>
				</li>
				<li>
					<span class="when">seit 09/2024</span>
					<strong>Lehrkraft</strong>
					<span class="meta">Staatliche Technikerschule Neumarkt i. d. OPf.</span>
					<ul>
						<li>Fachlicher Koordinator für die Fachrichtung KI</li>
						<li>Berater der Lehrplankommission für KI</li>
						<li>Fächer: Programmierung, KI, Informatik, Elektronik</li>
					</ul>
				</li>
				<li>
					<span class="when">08/2019–09/2022 (Vollzeit) · 03/2023–08/2024 (Teilzeit)</span>
					<strong>Senior Engineer – Wissenschaftlicher Mitarbeiter</strong>
					<span class="meta">Fraunhofer IIS, Gruppe Medizinische Sensorsysteme · Erlangen</span>
					<ul>
						<li>Embedded-C-Entwickler für 32-bit Mikrocontroller (nRF52/STM32, FreeRTOS/Zephyr OS + BLE)</li>
						<li>
							Projektleiter und Systemarchitekt für ein Sensorsystem zur Validierung eines Mobilisierungssitzes (Partner: Daimler Truck AG)
						</li>
					</ul>
				</li>
			</ol>
		</div>
	</section>

	<section aria-labelledby="education-heading">
		<h2 id="education-heading" class="section-title">Ausbildung</h2>
		<div class="timeline-card" style={{ background: 'var(--cream)' }}>
			<ol class="timeline">
				<li>
					<span class="when">09/2022–07/2024</span>
					<strong>Referendariat für das Lehramt an beruflichen Schulen, Fachrichtung Informationstechnik („Quereinstieg“)</strong>
					<span class="meta">Technikerschule Neumarkt i. d. OPf. · Zweites Staatsexamen</span>
				</li>
				<li>
					<span class="when">10/2017–08/2019</span>
					<strong>Masterstudiengang Elektronische und Mechatronische Systeme, Schwerpunkt Informationstechnik</strong>
					<span class="meta">TH Nürnberg · M.Eng.</span>
				</li>
			</ol>
		</div>
	</section>

	<a class="closing-card sketch" href={introPostHref}>
		<h2>Warum ich roomie gebaut habe</h2>
		<p>Die ganze Geschichte hinter roomie steht im ersten Blogbeitrag.</p>
		<span class="cta">→ zum Blogbeitrag</span>
	</a>
</BaseLayout>
