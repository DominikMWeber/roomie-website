---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/ui';

const locale: Locale = 'de';
---

<BaseLayout title="KI-Nutzung · Roomie" description="Transparenzhinweis zur KI-Nutzung" locale={locale}>
	<h1>KI-Nutzung</h1>
	<p class="placeholder">
		[PLATZHALTER: Hinweis einfügen, wo und wie KI-Werkzeuge bei dieser Website eingesetzt wurden
		— z. B. bei der Entwicklung des Codes, bei Texten/Übersetzungen oder bei Illustrationen —
		sowie eine Einordnung, welche Inhalte menschlich geprüft bzw. verantwortet werden.]
	</p>
</BaseLayout>

<style>
	h1 {
		margin: 0 0 28px;
		font-size: 2.6rem;
	}
	.placeholder {
		border: 2px dashed var(--ink-soft);
		border-radius: var(--radius-md);
		padding: 24px;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	@media (max-width: 700px) {
		h1 {
			font-size: 2rem;
		}
	}
</style>
