---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/ui';

const locale: Locale = 'de';
---

<BaseLayout title="Impressum · Roomie" description="Impressum" locale={locale}>
	<h1>Impressum</h1>
	<p class="placeholder">
		[PLACEHOLDER: Impressum-Text gemäß § 5 TMG einfügen — Name, Anschrift, Kontakt (E-Mail,
		ggf. Telefon), sowie ggf. Angaben zur inhaltlich verantwortlichen Person gemäß § 18 Abs. 2
		MStV.]
	</p>
</BaseLayout>

<style>
	h1 {
		margin: 0 0 28px;
		font-size: 2.6rem;
	}
	.placeholder {
		border: 2px dashed var(--ink-soft);
		border-radius: var(--radius-md);
		padding: 24px;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	@media (max-width: 700px) {
		h1 {
			font-size: 2rem;
		}
	}
</style>
