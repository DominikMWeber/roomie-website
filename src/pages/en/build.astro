---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

const locale: Locale = 'en';
const t = useTranslations(locale);
---

<BaseLayout title="Build · Roomie" description="Step-by-step tutorial for building your own roomie." locale={locale}>
	<header class="page-head">
		<h1>{t('build.title')}</h1>
		<p class="page-sub">{t('build.sub')}</p>
	</header>

	<p class="wip-notice">{t('build.notice')}</p>
</BaseLayout>
