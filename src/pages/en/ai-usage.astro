---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';

const locale: Locale = 'en';
---

<BaseLayout title="AI Usage · Roomie" description="AI usage disclosure" locale={locale}>
	<h1>AI Usage</h1>
	<p class="placeholder">
		[PLACEHOLDER: describe where and how AI tools were used for this website — e.g. in writing
		the code, in text/translations, or in illustrations — and clarify which content is
		human-reviewed or human-authored.]
	</p>
</BaseLayout>

<style>
	h1 {
		margin: 0 0 28px;
		font-size: 2.6rem;
	}
	.placeholder {
		border: 2px dashed var(--ink-soft);
		border-radius: var(--radius-md);
		padding: 24px;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	@media (max-width: 700px) {
		h1 {
			font-size: 2rem;
		}
	}
</style>
