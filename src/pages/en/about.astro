---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import '../../styles/about.css';

const locale: Locale = 'en';
const introPostHref = getRelativeLocaleUrl(locale, '/blog/roomie-intro');
---

<BaseLayout title="About me · Roomie" description="About me and how roomie came to be." locale={locale}>
	<header class="page-head">
		<h1>About me</h1>
		<p class="page-sub">The person behind roomie</p>
	</header>

	<section class="profile-hero tape">
		<img
			class="portrait"
			src="/images/authors/dominik-weber-large.png"
			width="240"
			height="240"
			alt="Dominik Weber"
			loading="eager"
			decoding="async"
		/>
		<div>
			<h2>Dominik Weber</h2>
			<p class="tagline">Master of Engineering | Teacher | Embedded Systems Engineer</p>
			<p>
				Hi! My name is Dominik! As a teacher for AI at a technical college and an engineer with
				several years of professional experience in firmware and embedded systems development, I
				passionately combine knowledge transfer with engineering.
			</p>
			<p>
				I believe that many things in life can be so much simpler when you present facts in an
				understandable way and are able to put yourself in other people's shoes.
			</p>
		</div>
	</section>

	<section aria-labelledby="hobbies-heading">
		<h2 id="hobbies-heading" class="section-title">Hobbies</h2>
		<ul class="hobby-grid">
			<li class="hobby-card" style={{ background: 'var(--mint)' }}>Drummer in a metal band</li>
			<li class="hobby-card" style={{ background: 'var(--lavender)' }}>Embedded and coding projects</li>
			<li class="hobby-card" style={{ background: 'var(--cream)' }}>AI-related literature and projects</li>
		</ul>
	</section>

	<section aria-labelledby="work-heading">
		<h2 id="work-heading" class="section-title">Work Experience</h2>
		<div class="timeline-card" style={{ background: 'var(--pink-soft)' }}>
			<ol class="timeline">
				<li>
					<span class="when">since 05/2026</span>
					<strong>Embedded Systems Engineer</strong>
					<span class="meta">PCB Arts GmbH · Fürth, Bavaria</span>
					<ul>
						<li>BSP development for Linux4Tegra on NVIDIA Jetson platforms</li>
					</ul>
				</li>
				<li>
					<span class="when">since 09/2024</span>
					<strong>Teacher</strong>
					<span class="meta">State Technical College Neumarkt i. d. OPf.</span>
					<ul>
						<li>Subject coordinator for the AI department</li>
						<li>Advisor to the AI curriculum committee</li>
						<li>Subjects: programming, AI, computer science, electronics</li>
					</ul>
				</li>
				<li>
					<span class="when">08/2019–09/2022 (full-time) · 03/2023–08/2024 (part-time)</span>
					<strong>Senior Engineer – Research Engineer</strong>
					<span class="meta">Fraunhofer IIS, Medical Sensor Systems Group · Erlangen</span>
					<ul>
						<li>Embedded C developer for 32-bit microcontrollers (nRF52/STM32, FreeRTOS/Zephyr OS + BLE)</li>
						<li>
							Project lead and system architect for a sensor system to validate a mobilization seat
							(partner: Daimler Truck AG)
						</li>
					</ul>
				</li>
			</ol>
		</div>
	</section>

	<section aria-labelledby="education-heading">
		<h2 id="education-heading" class="section-title">Education</h2>
		<div class="timeline-card" style={{ background: 'var(--cream)' }}>
			<ol class="timeline">
				<li>
					<span class="when">09/2022–07/2024</span>
					<strong>
						Teacher training ("Referendariat") for vocational schools, specializing in Information
						Technology (lateral entry)
					</strong>
					<span class="meta">Technikerschule Neumarkt i. d. OPf. · Second State Examination</span>
				</li>
				<li>
					<span class="when">10/2017–08/2019</span>
					<strong>
						Master's degree in Electronic and Mechatronic Systems, specializing in Information
						Technology
					</strong>
					<span class="meta">TH Nürnberg · M.Eng.</span>
				</li>
			</ol>
		</div>
	</section>

	<a class="closing-card sketch" href={introPostHref}>
		<h2>Why I built roomie</h2>
		<p>The full story behind roomie is in the first blog post.</p>
		<span class="cta">→ read the blog post</span>
	</a>

	<p class="ai-note">
		<em>
			Notes on the use of AI for this page: the German original was written by me based on my own
			CV, without generative AI. This English version was translated with Claude Code and then
			manually revised and checked by me.
		</em>
	</p>
</BaseLayout>
