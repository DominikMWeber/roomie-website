---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';

const locale: Locale = 'en';
---

<BaseLayout title="About me · Roomie" description="About me and how roomie came to be." locale={locale}>
	<h1>About me</h1>

	<section class="profile-hero">
		<img
			class="portrait"
			src="/images/authors/dominik-weber-large.png"
			width="240"
			height="240"
			alt="Dominik Weber"
			loading="eager"
			decoding="async"
		/>
		<div>
			<h2>Dominik Weber</h2>
			<p class="tagline">Master of Engineering | Teacher | Embedded Systems Engineer</p>
			<p>
				Hi! My name is Dominik! As a teacher for AI at a technical college and an engineer with
				several years of professional experience in firmware and embedded systems development, I
				passionately combine knowledge transfer with engineering.
			</p>
			<br />
			<p>
				I believe that many things in life can be so much simpler when you present facts in an
				understandable way and are able to put yourself in other people's shoes.
			</p>
		</div>
	</section>

	<section class="profile-card" style={{ background: 'var(--mint)' }}>
		<h2>Hobbies</h2>
		<ul>
			<li>Drummer in a metal band</li>
			<li>Embedded and coding projects</li>
			<li>AI-related literature and projects</li>
		</ul>
	</section>

	<section class="profile-card" style={{ background: 'var(--pink-soft)' }}>
		<h2>Work Experience</h2>
		<ul class="timeline">
			<li>
				<strong>Embedded Systems Engineer</strong>
				<span class="meta">PCB Arts GmbH · Fürth, Bavaria · since 05/2026</span>
				<ul>
					<li>BSP development for Linux4Tegra on NVIDIA Jetson platforms</li>
				</ul>
			</li>
			<li>
				<strong>Teacher</strong>
				<span class="meta">State Technical College Neumarkt i. d. OPf. · since 09/2024</span>
				<ul>
					<li>Subject coordinator for the AI department</li>
					<li>Advisor to the AI curriculum committee</li>
					<li>Subjects: programming, AI, computer science, electronics</li>
				</ul>
			</li>
			<li>
				<strong>Senior Engineer – Research Engineer</strong>
				<span class="meta">
					Fraunhofer IIS, Medical Sensor Systems Group · Erlangen · 08/2019–09/2022 (full-time),
					03/2023–08/2024 (part-time)
				</span>
				<ul>
					<li>Embedded C developer for 32-bit microcontrollers (nRF52/STM32, FreeRTOS/Zephyr OS + BLE)</li>
					<li>
						Project lead and system architect for a sensor system to validate a mobilization seat
						(partner: Daimler Truck AG)
					</li>
				</ul>
			</li>
		</ul>
	</section>

	<section class="profile-card" style={{ background: 'var(--cream)' }}>
		<h2>Education</h2>
		<ul class="timeline">
			<li>
				<strong>
					Teacher training ("Referendariat") for vocational schools, specializing in Information
					Technology (lateral entry)
				</strong>
				<span class="meta">Technikerschule Neumarkt i. d. OPf. · 09/2022–07/2024 · Second State Examination</span>
			</li>
			<li>
				<strong>
					Master's degree in Electronic and Mechatronic Systems, specializing in Information
					Technology
				</strong>
				<span class="meta">TH Nürnberg · 10/2017–08/2019 · M.Eng.</span>
			</li>
		</ul>
	</section>

	<p class="ai-note">
		<em>
			Notes on the use of AI for this page: the German original was written by me based on my own
			CV, without generative AI. This English version was translated with Claude Code and then
			manually revised and checked by me.
		</em>
	</p>
</BaseLayout>

<style>
	h1 {
		margin: 0 0 28px;
		font-size: 2.6rem;
	}
	.profile-hero {
		display: flex;
		align-items: center;
		gap: 32px;
		background: var(--sky);
		border: var(--border);
		border-radius: var(--radius-lg);
		padding: 32px;
		margin-bottom: 28px;
	}
	.portrait {
		flex-shrink: 0;
		width: 160px;
		height: 160px;
		border-radius: 50%;
	}
	.profile-hero h2 {
		margin: 0 0 6px;
		font-size: 1.6rem;
	}
	.tagline {
		margin: 0 0 12px;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--ink-soft);
	}
	.profile-hero p:not(.tagline) {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.6;
	}
	.profile-card {
		border: var(--border);
		border-radius: var(--radius-lg);
		padding: 32px;
		margin-bottom: 28px;
	}
	.profile-card h2 {
		margin: 0 0 18px;
		font-size: 1.4rem;
	}
	.profile-card ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.profile-card ul li {
		font-size: 1.05rem;
	}
	.profile-card ul:not(.timeline) li {
		padding-left: 1.4em;
		position: relative;
		margin-bottom: 10px;
	}
	.profile-card ul:not(.timeline) li::before {
		content: '●';
		position: absolute;
		left: 0;
		color: var(--pink);
	}
	.timeline > li {
		display: flex;
		flex-direction: column;
		padding: 16px 0;
		border-top: var(--border-thin);
	}
	.timeline > li:first-child {
		border-top: none;
		padding-top: 0;
	}
	.timeline > li:last-child {
		padding-bottom: 0;
	}
	.timeline .meta {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--ink-soft);
		margin-top: 4px;
	}
	.timeline li ul {
		margin-top: 12px;
	}
	.ai-note {
		margin: 0;
		max-width: 62ch;
		font-size: 0.95rem;
		line-height: 1.7;
		color: var(--ink-soft);
	}
	@media (max-width: 700px) {
		h1 {
			font-size: 2rem;
		}
		.profile-hero {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
