---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/ui';

const locale: Locale = 'de';
---

<BaseLayout title="Datenschutz · Roomie" description="Datenschutzerklärung" locale={locale}>
	<h1>Datenschutz</h1>
	<p class="placeholder">
		[PLACEHOLDER: Datenschutzerklärung gemäß DSGVO einfügen — u. a. verantwortliche Stelle,
		Hosting (deploybase, EU-Infrastruktur, IP-Adressen in Server-Logfiles, Löschung nach 30
		Tagen, keine Weitergabe an Dritte außerhalb der EU), Cookies (derzeit keine), eingebundene
		Schriftarten (selbst gehostet, keine Anfrage an Drittanbieter), Kontaktmöglichkeiten und
		Betroffenenrechte.]
	</p>
</BaseLayout>

<style>
	h1 {
		margin: 0 0 28px;
		font-size: 2.6rem;
	}
	.placeholder {
		border: 2px dashed var(--ink-soft);
		border-radius: var(--radius-md);
		padding: 24px;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	@media (max-width: 700px) {
		h1 {
			font-size: 2rem;
		}
	}
</style>
