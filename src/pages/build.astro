---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

const locale: Locale = 'de';
const t = useTranslations(locale);
---

<BaseLayout title="Bauen · Roomie" description="Schritt-für-Schritt-Anleitung zum Nachbauen von roomie." locale={locale}>
	<header class="page-head">
		<h1>{t('build.title')}</h1>
		<p class="page-sub">{t('build.sub')}</p>
	</header>

	<p class="wip-notice">{t('build.notice')}</p>
</BaseLayout>
