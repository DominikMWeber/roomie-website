---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="roomie">
	<div class="holding">
		<h1>Hier entsteht ein Webauftritt.</h1>
		<p class="en">A website is on its way.</p>
	</div>
</BaseLayout>

<style>
	.holding {
		min-height: 60vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		text-align: center;
	}
	h1 {
		margin: 0;
		font-size: clamp(1.6rem, 5vw, 2.6rem);
		font-weight: 700;
	}
	.en {
		margin: 0;
		font-size: 1.05rem;
		color: #5b646a;
	}
</style>
