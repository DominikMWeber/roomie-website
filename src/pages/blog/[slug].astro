---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorAvatar from '../../components/AuthorAvatar.astro';
import { getPostsForLocale } from '../../lib/blog';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

const locale: Locale = 'de';

export async function getStaticPaths() {
	const posts = await getPostsForLocale('de');
	return posts.map((post) => ({
		params: { slug: post.data.translationId },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(post);
---

<BaseLayout
	title={`${post.data.title} · ${t('site.title')}`}
	description={post.data.description}
	locale={locale}
>
	<article>
		<header class="page-head">
			<h1>{post.data.title}</h1>
			<p class="page-sub">{post.data.description}</p>
			<p class="byline">
				<AuthorAvatar author={post.data.author} locale={locale} />
				<span>
					{t('blog.by')} {post.data.author} ·{' '}
					<time datetime={post.data.date.toISOString()}>
						{post.data.date.toLocaleDateString(locale)}
					</time>
				</span>
			</p>
		</header>
		{post.data.locale !== locale && <p class="translation-note">{t('blog.notTranslated')}</p>}
		<div class="hero-image">
			<img src={post.data.image} alt="" />
		</div>
		<div class="content-card">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	/* author avatar, name and date in one centered line under the subline */
	.byline {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		margin: 18px 0 0;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}
	.hero-image {
		aspect-ratio: 16 / 8;
		border: var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		margin-bottom: 28px;
	}
	.hero-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.translation-note {
		margin: 0 0 24px;
		padding: 16px 20px;
		background: var(--cream);
		border: var(--border-thin);
		border-radius: var(--radius-md);
		font-style: italic;
	}
	.content-card {
		background: var(--paper);
		border: var(--border);
		border-radius: var(--radius-lg);
		padding: 32px;
		line-height: 1.7;
	}
	.content-card :global(p) {
		margin: 0 0 1.2em;
	}
	.content-card :global(p:last-child) {
		margin-bottom: 0;
	}
</style>
