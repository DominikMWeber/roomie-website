---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const homeHref = getRelativeLocaleUrl(locale, '/').replace(/\/$/, '') || '/';
const blogHref = getRelativeLocaleUrl(locale, '/blog').replace(/\/$/, '');
const isBlog = currentPath === blogHref || currentPath.startsWith(`${blogHref}/`);
---

<nav class="nav-links" aria-label={t('nav.home')}>
	<a
		href={homeHref}
		class:list={{ current: currentPath === homeHref }}
		aria-current={currentPath === homeHref ? 'page' : undefined}>{t('nav.home')}</a
	>
	<span class="nav-disabled" aria-disabled="true" title={t('nav.comingSoon')}>{t('nav.build')}</span>
	<a href={blogHref} class:list={{ current: isBlog }} aria-current={isBlog ? 'page' : undefined}
		>{t('nav.blog')}</a
	>
	<div class="dev-zone">
		<details class="dev-dropdown">
			<summary class="dev-trigger">
				{t('nav.dev')}
				<svg class="chevron-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
					<path
						d="M1 1L5 5L9 1"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</summary>
			<div class="dev-menu">
				<span class="dev-item" aria-disabled="true" title={t('nav.comingSoon')}>
					{t('nav.github')}
					<svg class="external-icon" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path
							d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5"
							stroke="currentColor"
							stroke-width="1.3"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</span>
				<span class="dev-item" aria-disabled="true" title={t('nav.comingSoon')}>
					{t('nav.docs')}
					<svg class="external-icon" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path
							d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5"
							stroke="currentColor"
							stroke-width="1.3"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</span>
			</div>
		</details>
	</div>
</nav>

<style>
	.nav-links {
		display: flex;
		gap: 6px;
		font-weight: 600;
		font-size: 1.05rem;
	}
	.nav-links a {
		text-decoration: none;
		padding: 10px 20px;
		border-radius: 999px;
	}
	.nav-links a:hover {
		background: var(--cream);
		color: var(--ink);
	}
	.nav-links a.current {
		background: var(--marker-yellow);
	}
	.nav-disabled {
		padding: 10px 20px;
		border-radius: 999px;
		color: var(--ink-soft);
		cursor: default;
	}
	.dev-zone {
		display: flex;
		align-items: center;
		margin-left: 8px;
		padding-left: 14px;
		border-left: var(--border-thin);
	}
	.dev-dropdown {
		position: relative;
	}
	.dev-trigger {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 10px 20px;
		border-radius: 999px;
		cursor: pointer;
		list-style: none;
	}
	.dev-trigger::-webkit-details-marker {
		display: none;
	}
	.dev-trigger:hover {
		background: var(--cream);
		color: var(--ink);
	}
	.chevron-icon {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}
	.dev-dropdown[open] .chevron-icon {
		transform: rotate(180deg);
	}
	.dev-menu {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		display: flex;
		flex-direction: column;
		min-width: 160px;
		background: var(--cream);
		border: var(--border-thin);
		border-radius: var(--radius-md);
		padding: 8px;
		gap: 2px;
		z-index: 10;
	}
	.dev-item {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 10px 14px;
		border-radius: var(--radius-md);
		color: var(--ink-soft);
		font-size: 0.95rem;
		cursor: default;
	}
	.external-icon {
		flex-shrink: 0;
	}
</style>
