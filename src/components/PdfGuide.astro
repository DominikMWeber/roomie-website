---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// Only a German guide exists; it is shown on both locales.
const pdfSrc = '/manuals/roomie-kurzanleitung-de-v2.pdf';
---

<section aria-labelledby="guide-heading">
	<h2 id="guide-heading" class="section-title">{t('guide.title')}</h2>
	<div class="guide-card">
		<div class="guide-intro">
			<p>{t('guide.desc')}</p>
			{locale === 'en' && <p class="guide-note">{t('guide.deOnly')}</p>}
		</div>

		<div class="pdf-viewer">
			<iframe src={`${pdfSrc}#view=Fit&toolbar=0`} title={t('guide.title')} />
		</div>
		<a class="pdf-open" href={pdfSrc} target="_blank" rel="noopener">{t('guide.openPdf')}</a>
	</div>
</section>

<style>
	.guide-card {
		background: var(--lavender);
		border: var(--border);
		border-radius: var(--radius-lg);
		padding: 32px;
		margin-bottom: 28px;
	}
	.guide-intro {
		margin-bottom: 22px;
	}
	.guide-intro p {
		margin: 0;
		font-size: 1.05rem;
	}
	.guide-intro .guide-note {
		margin-top: 8px;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--ink-soft);
	}
	.pdf-viewer {
		background: var(--paper);
		border: var(--border-thin);
		border-radius: var(--radius-md);
		/* matches the A4 portrait page so the whole page fits without scrolling */
		aspect-ratio: 1 / 1.414;
		overflow: hidden;
	}
	.pdf-viewer iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
	.pdf-open {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 20px;
		font-weight: 700;
		font-family: var(--font-display);
		font-size: 1.05rem;
		background: var(--paper);
		border: var(--border-thin);
		border-radius: 999px;
		padding: 14px 24px;
		text-decoration: none;
	}
	.pdf-open:hover {
		background: var(--ink);
		color: var(--paper);
	}
</style>
