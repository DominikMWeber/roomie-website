---
interface Props {
	text: string;
	attribution: string;
	/** Short second signature line under the name, e.g. the person's role. */
	role?: string;
	readMoreLabel: string;
	readMoreHref?: string;
	imageSrc?: string;
	imageAlt?: string;
	imageHref?: string;
	/** Tapes the card's two top corners with decorative washi-tape strips. */
	tape?: boolean;
}
const {
	text,
	attribution,
	role,
	readMoreLabel,
	readMoreHref = '#',
	imageSrc,
	imageAlt = '',
	imageHref,
	tape = false,
} = Astro.props;
---

<section class:list={['quote-card', { 'tape-corners': tape }]}>
	<figure>
		<blockquote>
			<p>{text}</p>
		</blockquote>
		<figcaption>
			{
				imageSrc && (
					<a class="quote-portrait-link" href={imageHref ?? '#'} aria-label={imageAlt}>
						<img class="quote-portrait" src={imageSrc} width="160" height="160" alt={imageAlt} loading="lazy" decoding="async" />
					</a>
				)
			}
			<span class="signature">
				<span class="attribution">{attribution}</span>
				{role && <span class="role">{role}</span>}
			</span>
			<a class="read-more" href={readMoreHref}>{readMoreLabel}</a>
		</figcaption>
	</figure>
</section>

<style>
	.quote-card {
		background: var(--sky);
		border: var(--border);
		border-radius: var(--radius-lg);
		padding: 32px 36px;
		margin-bottom: 28px;
	}
	figure {
		margin: 0;
	}
	blockquote {
		margin: 0;
	}
	/* large decorative quotation mark; the empty alt text keeps it out of screen readers */
	blockquote::before {
		content: '“' / '';
		display: block;
		height: 0.45em;
		margin-bottom: 4px;
		font-family: var(--font-display);
		font-size: 6.5rem;
		font-weight: 700;
		line-height: 1;
		color: var(--pink);
	}
	blockquote p {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.4rem;
		line-height: 1.45;
	}
	/* signature line: portrait, name + role, read-more link on the right */
	figcaption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 16px;
		margin-top: 28px;
	}
	.signature {
		display: flex;
		flex-direction: column;
	}
	.attribution {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.3rem;
		line-height: 1.2;
	}
	.role {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--ink-soft);
	}
	.read-more {
		margin-left: auto;
		font-weight: 600;
	}
	.quote-portrait-link {
		display: block;
		border-radius: 50%;
		transition: translate 0.2s ease;
	}
	.quote-portrait-link:hover,
	.quote-portrait-link:focus-visible {
		translate: 0 -4px;
	}
	.quote-portrait {
		display: block;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		border: var(--border-thin);
		transition: box-shadow 0.2s ease;
	}
	.quote-portrait-link:hover .quote-portrait,
	.quote-portrait-link:focus-visible .quote-portrait {
		box-shadow: 3px 3px 0 var(--ink);
	}
	@media (max-width: 700px) {
		.quote-card {
			padding: 28px 24px;
		}
		blockquote p {
			font-size: 1.2rem;
		}
		/* link drops onto its own line under the signature */
		.read-more {
			flex-basis: 100%;
			margin-left: 0;
		}
	}
</style>
