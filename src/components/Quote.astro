---
interface Props {
	text: string;
	attribution: string;
	readMoreLabel: string;
	readMoreHref?: string;
	imageSrc?: string;
	imageAlt?: string;
	imageHref?: string;
	/** Adds a decorative strip of washi tape across the top of the white card. */
	tape?: boolean;
}
const {
	text,
	attribution,
	readMoreLabel,
	readMoreHref = '#',
	imageSrc,
	imageAlt = '',
	imageHref,
	tape = false,
} = Astro.props;
---

<section class="quote-card">
	{/* figcaption must be the figure's first or last child, so the portrait sits between; grid places it on the right */}
	<figure class:list={['quote-inner', { tape }]}>
		<blockquote>
			<p>{text}</p>
		</blockquote>
		{
			imageSrc && (
				<a class="quote-portrait-link" href={imageHref ?? '#'} aria-label={imageAlt}>
					<img class="quote-portrait" src={imageSrc} width="160" height="160" alt={imageAlt} loading="lazy" decoding="async" />
				</a>
			)
		}
		<figcaption>
			<span class="attribution">{attribution}</span>
			<a class="read-more" href={readMoreHref}>{readMoreLabel}</a>
		</figcaption>
	</figure>
</section>

<style>
	.quote-card {
		background: var(--sky);
		border: var(--border);
		border-radius: var(--radius-lg);
		padding: 32px;
		margin-bottom: 28px;
	}
	.quote-inner {
		background: var(--paper);
		border: var(--border-thin);
		border-radius: var(--radius-md);
		margin: 0;
		padding: 28px 32px;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		column-gap: 28px;
	}
	blockquote {
		grid-column: 1;
		grid-row: 1;
		margin: 0;
	}
	/* large decorative quotation mark; the empty alt text keeps it out of screen readers */
	blockquote::before {
		content: '“' / '';
		display: block;
		height: 0.45em;
		margin-bottom: 4px;
		font-family: var(--font-display);
		font-size: 6.5rem;
		font-weight: 700;
		line-height: 1;
		color: var(--pink);
	}
	blockquote p {
		margin: 0;
		font-size: 1.15rem;
	}
	figcaption {
		grid-column: 1;
		grid-row: 2;
	}
	.quote-card .attribution {
		display: block;
		margin-top: 16px;
		font-weight: 700;
		font-family: var(--font-display);
		font-size: 1.05rem;
	}
	.quote-card .read-more {
		display: inline-block;
		margin-top: 16px;
		font-weight: 600;
	}
	.quote-portrait-link {
		grid-column: 2;
		grid-row: 1 / 3;
		display: block;
		border-radius: 50%;
		transition: translate 0.2s ease;
	}
	.quote-portrait-link:hover,
	.quote-portrait-link:focus-visible {
		translate: 0 -8px;
	}
	.quote-portrait {
		display: block;
		width: 120px;
		height: 120px;
		border-radius: 50%;
		border: var(--border-thin);
		transition: box-shadow 0.2s ease;
	}
	.quote-portrait-link:hover .quote-portrait,
	.quote-portrait-link:focus-visible .quote-portrait {
		box-shadow: 3px 3px 0 var(--ink);
	}
	@media (max-width: 700px) {
		.quote-inner {
			grid-template-columns: 1fr;
			row-gap: 20px;
			text-align: center;
		}
		.quote-portrait-link {
			grid-column: 1;
			grid-row: 1;
			justify-self: center;
		}
		blockquote {
			grid-row: 2;
		}
		figcaption {
			grid-row: 3;
		}
	}
</style>
