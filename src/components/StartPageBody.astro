---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Quote from './Quote.astro';
import FeatureList from './FeatureList.astro';
import BlogTeaser from './BlogTeaser.astro';
import PdfGuide from './PdfGuide.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// The quote is an excerpt from the intro post — link straight to it.
const introPostHref = getRelativeLocaleUrl(locale, '/blog/roomie-intro');
const aboutHref = getRelativeLocaleUrl(locale, '/about');
---

<section class="hero">
	<div class="mascot-wrap">
		<img
			src="/images/mascot-companions-title.png"
			width="600"
			height="575"
			alt="roomie"
			loading="lazy"
			decoding="async"
		/>
	</div>
	<h1 class="tagline">
		{t('hero.tagline.prefix')}<span class="marker is-on">{t('hero.tagline.highlight')}</span>
	</h1>
</section>

<p class="wip-notice">{t('hero.wip')}</p>

<Quote
	text={t('quote.text')}
	attribution={t('quote.attribution')}
	readMoreLabel={t('quote.readMore')}
	readMoreHref={introPostHref}
	imageSrc="/images/authors/dominik-weber-large.png"
	imageAlt="Dominik Weber"
	imageHref={aboutHref}
/>

<FeatureList locale={locale} />

<BlogTeaser locale={locale} />

<PdfGuide locale={locale} />

<style>
	.hero {
		background: var(--sky);
		border: var(--border);
		border-radius: var(--radius-lg);
		padding: 56px 32px;
		text-align: center;
		margin-bottom: 28px;
	}
	.mascot-wrap {
		width: 240px;
		margin: 0 auto 32px;
	}
	.mascot-wrap img {
		display: block;
		width: 100%;
		height: auto;
	}
	.tagline {
		font-size: 2rem;
		line-height: 1.3;
		max-width: 34ch;
		margin: 0 auto;
	}
	.tagline .marker {
		display: block;
		font-size: 0.75em;
		margin-top: 0.6em;
	}
	.wip-notice {
		border: 2px dashed var(--ink-soft);
		border-radius: var(--radius-md);
		padding: 24px;
		margin: 0 0 28px;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
		text-align: center;
	}
	@media (max-width: 700px) {
		.tagline {
			font-size: 1.55rem;
		}
	}
</style>
