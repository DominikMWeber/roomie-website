---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { AUTHOR_AVATARS } from '../lib/authors';
import type { Locale } from '../i18n/ui';

interface Props {
	author: string;
	locale: Locale;
}
const { author, locale } = Astro.props;
const avatar = AUTHOR_AVATARS[author];
---

{
	avatar && (
		<a class="author-avatar" href={getRelativeLocaleUrl(locale, '/about')} aria-label={author}>
			<img src={avatar} alt={author} width="48" height="48" loading="lazy" decoding="async" />
		</a>
	)
}

<style>
	.author-avatar {
		display: inline-block;
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		border-radius: 50%;
		border: var(--border-thin);
		overflow: hidden;
		transition: translate 0.15s ease;
	}
	.author-avatar:hover,
	.author-avatar:focus-visible {
		translate: 0 -2px;
	}
	.author-avatar img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
