---
interface Props {
	size?: string;
	/** Purely decorative by default — adjacent text already identifies Roomie. */
	decorative?: boolean;
}
const { size = '180px', decorative = true } = Astro.props;
---

<img
	src="/images/mascot-companions.png"
	width="600"
	height="467"
	style={`width: ${size}; height: auto;`}
	alt={decorative ? '' : 'Roomie logo'}
	aria-hidden={decorative ? 'true' : undefined}
	loading="lazy"
	decoding="async"
/>
