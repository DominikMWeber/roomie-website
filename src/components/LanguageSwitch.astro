---
import { languages, type Locale } from '../i18n/ui';
import { getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
	locale: Locale;
	/** Set to false for pages that only exist in one language (e.g. Impressum). */
	translated?: boolean;
}
const { locale, translated = true } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
const codes = Object.keys(languages) as Locale[];
---

<div class="lang">
	{
		codes.map((code) =>
			code === locale || translated ? (
				<a
					href={getLocalizedPath(pathname, code)}
					class:list={{ on: code === locale }}
					aria-current={code === locale ? 'true' : undefined}
				>
					{code.toUpperCase()}
				</a>
			) : (
				<span class="disabled" aria-disabled="true" title={t('lang.notAvailable')}>
					{code.toUpperCase()}
				</span>
			),
		)
	}
</div>

<style>
	.lang {
		display: flex;
		gap: 4px;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 600;
		border: var(--border-thin);
		border-radius: 999px;
		padding: 4px;
	}
	.lang a,
	.lang .disabled {
		padding: 7px 14px;
		border-radius: 999px;
		color: var(--ink);
	}
	.lang a {
		text-decoration: none;
	}
	.lang a.on {
		background: var(--ink);
		color: var(--paper);
	}
	.lang .disabled {
		color: var(--ink-soft);
		opacity: 0.5;
		cursor: not-allowed;
	}
</style>
